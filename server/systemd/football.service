[Unit]
Description=Table Football Flask Server
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Desktop/server
EnvironmentFile=/home/pi/Desktop/server/.env
ExecStart=/home/pi/Desktop/server/venv/bin/python app.py
Restart=on-failure
RestartSec=5

# Tighten down a bit. The service only needs to read/write its own folder.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

# SERVER_PORT defaults to 80 (see .env.example) so the dashboard needs no
# port in the URL. Binding <1024 normally needs root; grant just this one
# capability instead of running the whole service as root. Ambient caps
# work fine together with NoNewPrivileges=true above.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
