# Copy this file to `.env` and edit values before running the server.
# Never commit a real `.env` file.

# Password for /admin login.
ADMIN_PASSWORD=admin123

# Random secret used to sign Flask session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite database file (relative paths are resolved against the server/ folder).
DB_PATH=football.db

# MQTT broker (mosquitto runs on the Pi itself, so localhost is the default).
MQTT_HOST=localhost
MQTT_PORT=1883

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Default win condition (goals). Per-table override is stored in tables.max_score.
MAX_SCORE=10

# How many seconds without a heartbeat before a Pico is marked offline.
PICO_OFFLINE_SEC=30
